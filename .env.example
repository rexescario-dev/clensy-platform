DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=clensy
DB_PASSWORD=clensy_dev
DB_NAME=clensy

# Secret used to sign/verify session JWTs (platform/auth). Required outside
# test environments — TokenService/JwtStrategy refuse to start without it.
# Generate a real random value per environment; never commit a real secret.
JWT_SECRET=
# Session JWT lifetime (spec §4.1); also drives the session cookie's
# Max-Age (Task 5/8) so the two never drift independently.
JWT_EXPIRES_IN=8h

# Dev-only convenience seed for a single Owner admin account (see
# platform/database/seed.ts). Both must be set for the seed to run; leave
# unset to skip it. Not real credentials — do not commit actual values.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Operator debug umbrella. Only the exact string `true` enables it; unset,
# `false`, `1`, `TRUE`, etc. all stay off. Today this turns on TypeORM query
# logging (`query: SELECT ...` on API stdout). Later debug channels can
# subscribe to the same flag. Local operator switch — recreate the API
# container after changing it (`docker compose up -d api`).
APP_DEBUG=

# Origin of the `apps/web` frontend, used for credentialed CORS (main.ts) so
# the browser can send the HttpOnly session cookie across the apps/web <->
# apps/api origin boundary. Defaults to http://localhost:3001 (apps/web's
# local dev port) when unset.
WEB_ORIGIN=http://localhost:3001
