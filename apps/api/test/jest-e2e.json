{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "setupFiles": ["<rootDir>/setup-e2e-env.ts"],
  "globalSetup": "<rootDir>/global-setup.ts",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(?:\\.pnpm/)?uuid)"
  ],
  "maxWorkers": 1
}
