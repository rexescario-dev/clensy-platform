# URL of apps/api's GraphQL endpoint, consumed by @clensy/client's Apollo
# Client instance (packages/client/src/apollo-client.ts). NEXT_PUBLIC_
# because the client runs in the browser (credentials: 'include' needs the
# browser itself to attach the session cookie — see apollo-client.ts).
# Defaults to http://localhost:3000/graphql (apps/api's local dev port —
# see apps/api/src/main.ts) when unset.
NEXT_PUBLIC_API_URL=http://localhost:3000/graphql
